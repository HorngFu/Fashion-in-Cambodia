# Copy to .env.local for local development. Never commit real values.

# Cloudflare Web Analytics token (public; optional).
# Dashboard → Analytics & Logs → Web Analytics → your site → "Manage site".
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Public URL of the site, used for absolute links in page metadata.
# Defaults to https://fashion-in-cambodia.horngfu.workers.dev
NEXT_PUBLIC_SITE_URL=
